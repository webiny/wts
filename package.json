{
  "name": "@webiny/wts-client",
  "type": "module",
  "version": "3.0.0",
  "description": "Webiny Telemetry Service (WTS) client library.",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./web": {
      "types": "./web.d.ts",
      "import": "./web.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "import": "./node.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.js.map",
    "**/*.d.ts.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp package.json dist/package.json",
    "test:web": "tsx --test __tests__/web.test.ts",
    "test:node": "tsx --test __tests__/node.test.ts",
    "test:react": "tsx --test __tests__/react.test.tsx",
    "test": "tsx --test __tests__/web.test.ts __tests__/node.test.ts __tests__/react.test.tsx",
    "prettier:run": "prettier \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "prettier:run:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webiny/wts.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webiny/wts/issues"
  },
  "homepage": "https://github.com/webiny/wts#readme",
  "peerDependencies": {
    "posthog-js": ">=1.180.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "posthog-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^18.3.29",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "posthog-js": "^1.376.4",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.16.0"
}
