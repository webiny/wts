{
  "name": "@webiny/wts-client",
  "type": "module",
  "version": "3.0.0",
  "description": "Webiny Telemetry Service (WTS) client library.",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./web": {
      "types": "./web.d.ts",
      "import": "./web.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "import": "./node.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.js.map",
    "**/*.d.ts.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp package.json dist/package.json",
    "test:web": "tsx --test __tests__/web.test.ts",
    "test:node": "tsx --test __tests__/node.test.ts",
    "test:react": "tsx --test __tests__/react.test.tsx",
    "test": "tsx --test __tests__/web.test.ts __tests__/node.test.ts __tests__/react.test.tsx",
    "lint": "prettier \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webiny/wts.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webiny/wts/issues"
  },
  "homepage": "https://github.com/webiny/wts#readme",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "yarn@4.5.0"
}
